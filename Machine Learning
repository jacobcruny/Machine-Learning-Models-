# ----------------------------------------------------------
# 1. Import Libraries
# ----------------------------------------------------------

import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

from xgboost import XGBRegressor

# ----------------------------------------------------------
# 2. Load Dataset
# ----------------------------------------------------------

df = pd.read_excel("Data for Poisson Regression.xlsx")

print("Dataset Shape:", df.shape)
print(df.head())

# ----------------------------------------------------------
# 3. Keep Variables
# ----------------------------------------------------------

df = df[[
    "Industry",
    "Revenue",
    "# of Employees",
    "CISO / CIO",
    "Public / Private ",
    "Records_Affected"
]]

# ----------------------------------------------------------
# 4. Remove Missing Values
# ----------------------------------------------------------

df = df.dropna()

print("\nDataset Shape After Removing Missing Values:")
print(df.shape)

# ----------------------------------------------------------
# 5. Response Variable
# ----------------------------------------------------------

y = df["Records_Affected"]

# ----------------------------------------------------------
# 6. Predictor Variables
# ----------------------------------------------------------

X = df.drop(columns=["Records_Affected"])

# ----------------------------------------------------------
# 7. Convert Categorical Variables
# ----------------------------------------------------------

X = pd.get_dummies(
    X,
    columns=[
        "Industry",
        "Public / Private "
    ],
    drop_first=True
)

# ----------------------------------------------------------
# 8. Train/Test Split
# ----------------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42
)

print("\nTraining observations:", len(X_train))
print("Testing observations:", len(X_test))

# ----------------------------------------------------------
# 9. Fit XGBoost Model
# ----------------------------------------------------------

xgb = XGBRegressor(
    objective="reg:squarederror",
    n_estimators=500,
    learning_rate=0.05,
    max_depth=4,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42
)

xgb.fit(X_train, y_train)

# ----------------------------------------------------------
# 10. Predict
# ----------------------------------------------------------

y_pred = xgb.predict(X_test)

# ----------------------------------------------------------
# 11. Model Performance
# ----------------------------------------------------------

mae = mean_absolute_error(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
r2 = r2_score(y_test, y_pred)

print("\n==============================")
print("XGBoost Performance")
print("==============================")
print(f"MAE : {mae:,.2f}")
print(f"RMSE: {rmse:,.2f}")
print(f"R²  : {r2:.4f}")

# ----------------------------------------------------------
# 12. Actual vs Predicted
# ----------------------------------------------------------

comparison = pd.DataFrame({
    "Actual": y_test.values,
    "Predicted": np.round(y_pred)
})

print("\nFirst 20 Predictions")
print(comparison.head(20))

# ----------------------------------------------------------
# 13. Feature Importance
# ----------------------------------------------------------

importance = pd.DataFrame({
    "Variable": X.columns,
    "Importance": xgb.feature_importances_
})

importance = importance.sort_values(
    by="Importance",
    ascending=False
)

print("\nFeature Importance")
print(importance)

# ----------------------------------------------------------
# 14. Save Feature Importance (Optional)
# ----------------------------------------------------------

importance.to_csv(
    "XGBoost_FeatureImportance.csv",
    index=False
)
